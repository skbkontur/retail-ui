{
  "name": "@skbkontur/colors",
  "version": "2.0.5",
  "author": "Kontur",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "license": "UNLICENSED",
  "sideEffects": false,
  "files": [
    "/lib",
    "/tokens",
    "/tokens-mobile",
    "/*.{js,d.ts,less,scss}"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./get-colors": {
      "types": "./get-colors.d.ts",
      "default": "./get-colors.js"
    },
    "./default-light": {
      "types": "./default-light.d.ts",
      "default": "./default-light.js"
    },
    "./default-dark": {
      "types": "./default-dark.d.ts",
      "default": "./default-dark.js"
    },
    "./colors.scss": "./colors.scss",
    "./colors.less": "./colors.less",
    "./tokens/brand-orange_accent-gray.css": "./tokens/brand-orange_accent-gray.css",
    "./tokens/brand-blue_accent-gray.css": "./tokens/brand-blue_accent-gray.css",
    "./tokens/brand-blue_accent-brand.css": "./tokens/brand-blue_accent-brand.css",
    "./tokens/brand-blue-deep_accent-brand.css": "./tokens/brand-blue-deep_accent-brand.css",
    "./tokens/brand-blue-deep_accent-gray.css": "./tokens/brand-blue-deep_accent-gray.css",
    "./tokens/brand-green_accent-brand.css": "./tokens/brand-green_accent-brand.css",
    "./tokens/brand-green_accent-gray.css": "./tokens/brand-green_accent-gray.css",
    "./tokens/brand-mint_accent-brand.css": "./tokens/brand-mint_accent-brand.css",
    "./tokens/brand-mint_accent-gray.css": "./tokens/brand-mint_accent-gray.css",
    "./tokens/brand-purple_accent-brand.css": "./tokens/brand-purple_accent-brand.css",
    "./tokens/brand-purple_accent-gray.css": "./tokens/brand-purple_accent-gray.css",
    "./tokens/brand-violet_accent-brand.css": "./tokens/brand-violet_accent-brand.css",
    "./tokens/brand-violet_accent-gray.css": "./tokens/brand-violet_accent-gray.css",
    "./tokens-mobile/brand-orange_accent-gray.json": "./tokens-mobile/brand-orange_accent-gray.json",
    "./tokens-mobile/brand-blue_accent-gray.json": "./tokens-mobile/brand-blue_accent-gray.json",
    "./tokens-mobile/brand-blue_accent-brand.json": "./tokens-mobile/brand-blue_accent-brand.json",
    "./tokens-mobile/brand-blue-deep_accent-brand.json": "./tokens-mobile/brand-blue-deep_accent-brand.json",
    "./tokens-mobile/brand-blue-deep_accent-gray.json": "./tokens-mobile/brand-blue-deep_accent-gray.json",
    "./tokens-mobile/brand-green_accent-brand.json": "./tokens-mobile/brand-green_accent-brand.json",
    "./tokens-mobile/brand-green_accent-gray.json": "./tokens-mobile/brand-green_accent-gray.json",
    "./tokens-mobile/brand-mint_accent-brand.json": "./tokens-mobile/brand-mint_accent-brand.json",
    "./tokens-mobile/brand-mint_accent-gray.json": "./tokens-mobile/brand-mint_accent-gray.json",
    "./tokens-mobile/brand-purple_accent-brand.json": "./tokens-mobile/brand-purple_accent-brand.json",
    "./tokens-mobile/brand-purple_accent-gray.json": "./tokens-mobile/brand-purple_accent-gray.json",
    "./tokens-mobile/brand-violet_accent-brand.json": "./tokens-mobile/brand-violet_accent-brand.json",
    "./tokens-mobile/brand-violet_accent-gray.json": "./tokens-mobile/brand-violet_accent-gray.json"
  },
  "scripts": {
    "prebuild": "node --import=tsx scripts/create-tokens-from-figma.ts",
    "build": "npm run build:static && npm run build:esm",
    "build:esm": "tsc",
    "build:static": "node --import=tsx scripts/create-tokens-files.ts && npm run format",
    "build:snapshots": "node --import=tsx scripts/create-tokens-snapshots.ts && npm run format",
    "test": "yarn build:snapshots && vitest run",
    "test:watch": "vitest",
    "test:update-snapshots": "vitest run -u",
    "format": "prettier . --write && npx stylelint \"**/*.{css,scss,less}\" --fix",
    "clean": "git clean -fdxqe node_modules"
  },
  "dependencies": {
    "apca-w3": "0.1.9",
    "culori": "4.0.2"
  },
  "devDependencies": {
    "@skbkontur/react-ui": "5.5.1",
    "@types/apca-w3": "0.1.3",
    "@types/culori": "4.0.1",
    "vitest": "^2.1.6"
  }
}
