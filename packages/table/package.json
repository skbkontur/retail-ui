{
  "name": "@skbkontur/table",
  "description": "Table",
  "version": "0.1.8",
  "main": "./dist/cjs/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "index.ts",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "clean": "rimraf dist && git clean -fdxqe node_modules",
    "prebuild": "yarn clean",
    "build": "yarn build:vite",
    "build:vite": "vite build",
    "build:types": "tsc --outDir dist",
    "build:watch": "vite build --watch",
    "build:prettier": "prettier --write .",
    "dev": "vite build --watch --mode development",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@skbkontur/colors": "^2.1.1",
    "@skbkontur/icons": "2.0.1",
    "@skbkontur/react-ui": "^5.0.0",
    "@skbkontur/typography": "^0.1.3",
    "@testing-library/jest-dom": "5.16.2",
    "@testing-library/react": "12.1.3",
    "@testing-library/user-event": "13.5.0",
    "@vitejs/plugin-react": "^4.2.1",
    "css-has-pseudo": "^7.0.3",
    "jsdom": "15.2.1",
    "postcss": "8.5.6",
    "rimraf": "^6.0.1",
    "typescript": ">=5.0.0",
    "vite": "^6.3.6",
    "vite-plugin-css-injected-by-js": "3.5.2",
    "vite-plugin-dts": "4.0.3",
    "vite-plugin-lib-inject-css": "^2.1.1",
    "vitest": "^2.1.6"
  },
  "dependencies": {
    "@skbkontur/global-object": "^0.4.5",
    "classnames": "^2"
  },
  "peerDependencies": {
    "@skbkontur/react-ui": ">=5.0.0 <6.0.0",
    "react": ">=16.14",
    "react-dom": ">=16.14"
  },
  "optionalDependencies": {
    "@esbuild/darwin-arm64": "^0.24.0",
    "@esbuild/linux-arm64": "^0.24.0",
    "@rollup/rollup-darwin-arm64": "^4.52.5",
    "@rollup/rollup-linux-x64-gnu": "^4.52.5"
  },
  "author": "Kontur"
}
