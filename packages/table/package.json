{
  "name": "@skbkontur/table",
  "version": "1.0.4",
  "description": "Table",
  "author": "holkin@skbkontur.ru",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./index.ts"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "prerelease": "yarn build",
    "release": "npm publish ./dist --workspaces=false",
    "release:unstable": "yarn release --tag=unstable",
    "clean": "rimraf dist",
    "lint": "npm-run-all --continue-on-error --parallel lint:*",
    "lint:tsc": "tsc --noEmit --diagnostics",
    "lint:oxlint": "oxlint .",
    "lint:oxfmt": "node ../../scripts/run-oxfmt.mjs --check .",
    "prebuild": "yarn clean",
    "build": "run-s build:* build:lint:*",
    "build:tsc": "yarn tsc",
    "build:vite": "vite build",
    "build:copyfiles": "copyfiles package.json README.md CHANGELOG.md dist",
    "build:exports": "node ../../scripts/generate-exports.mts ./dist/package.json",
    "build:lint:publint": "publint --pack npm ./dist",
    "build:lint:attw": "attw --config-path ../../.attw.json ./dist",
    "dev": "vite build --watch --mode development",
    "test": "vitest run",
    "test:watch": "vitest",
    "storybook": "yarn build && storybook dev -p 6066",
    "storybook:build": "yarn build && storybook build -o .storybook/build --quiet",
    "storybook:docs-build": "yarn build && storybook build --docs -c .storybook-docs -o .storybook/build --quiet",
    "storybook:docs": "yarn build && storybook dev --docs -p 6067 -c .storybook-docs",
    "storybook:test": "yarn build && storybook dev --ci -p 6060",
    "storybook:serve": "serve -l 6060 .storybook/build",
    "creevey": "creevey test -c .creevey/config.mts --storybook-port=6060",
    "creevey:ci": "start-server-and-test storybook:serve http://localhost:6060 creevey",
    "creevey:update": "creevey -c .creevey/config.mts --update",
    "creevey:ui": "yarn creevey --ui"
  },
  "dependencies": {
    "@skbkontur/colors": "^2.1.7",
    "@skbkontur/global-object": "^0.4.5",
    "@skbkontur/icons": "^2.0.1",
    "@skbkontur/typography": "^1.0.1",
    "classnames": "^2"
  },
  "devDependencies": {
    "@babel/core": "^7.24.6",
    "@babel/plugin-proposal-decorators": "7.24.6",
    "@babel/plugin-transform-runtime": "^7.24.6",
    "@babel/preset-env": "^7.24.6",
    "@babel/preset-react": "^7.24.6",
    "@babel/preset-typescript": "^7.24.6",
    "@emotion/css": "^11.11.2",
    "@playwright/test": "1.59.1",
    "@skbkontur/empty-state": "^2.0.2",
    "@skbkontur/react-ui": ">=5.1.0 <=6",
    "@skbkontur/storybook-addon-live-examples": "1.0.0-beta.1",
    "@storybook/addon-docs": "8.6.14",
    "@storybook/addon-essentials": "8.6.14",
    "@storybook/blocks": "8.6.14",
    "@storybook/react": "8.6.14",
    "@storybook/react-webpack5": "8.6.14",
    "@tanstack/react-virtual": "3.14.4",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "15.0.7",
    "@testing-library/user-event": "13.5.0",
    "@vitejs/plugin-react": "^4.2.1",
    "babel-loader": "^9.1.3",
    "core-js": "^3.37.1",
    "creevey": "0.10.34",
    "dotenv": "^16.4.5",
    "jsdom": "^26.1.0",
    "playwright-core": "1.59.1",
    "rimraf": "^6.0.1",
    "serve": "^13.0.2",
    "start-server-and-test": "1.14.0",
    "storybook": "8.6.14",
    "string-replace-loader": "3.1.0",
    "terser": "^5.36.0",
    "typescript": "5.9.3",
    "vite": "^6.3.6",
    "vite-plugin-css-injected-by-js": "^3.5.2",
    "vite-plugin-dts": "4.0.3",
    "vitest": "^2.1.6"
  },
  "peerDependencies": {
    "@skbkontur/react-ui": ">=5.1.0 <=6",
    "react": ">=16.9 <20",
    "react-dom": ">=16.9 <20"
  },
  "optionalDependencies": {
    "@esbuild/darwin-arm64": "^0.24.0",
    "@esbuild/linux-arm64": "^0.24.0",
    "@rollup/rollup-darwin-arm64": "^4.52.5",
    "@rollup/rollup-linux-x64-gnu": "^4.52.5"
  }
}
