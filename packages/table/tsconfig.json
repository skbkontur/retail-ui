{
  "extends": "../../tsconfig",
  "compilerOptions": {
    "target": "ES2015",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2015", "ES2019", "DOM", "DOM.Iterable"],
    "jsx": "react",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowSyntheticDefaultImports": true,
    "noEmit": true,
    "preserveWatchOutput": true,
    "incremental": true,
    "composite": false,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      // Source-exports react-ui: `./components/*` → `*.tsx`, а компоненты — директории с index.
      "@skbkontur/react-ui": ["../react-ui/index.ts"],
      "@skbkontur/react-ui/*": ["../react-ui/*"]
    }
  },
  "exclude": [
    "node_modules",
    "**/node_modules",
    "__stories__",
    "__tests__",
    "__docs__",
    "dist",
    "**/*.stories.tsx",
    "**/*.stories.ts",
    "src/components/TableExample",
    "vite.config.ts"
  ],
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.d.ts",
    "index.ts",
    // Как у react-ui-validations: типы для __KONTUR_REACT_UI__ и stylis при workspace-link.
    "../react-ui/typings/**/*"
  ]
}
