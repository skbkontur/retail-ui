{
  "name": "@skbkontur/typography",
  "version": "1.0.3",
  "description": "Kontur UI Typography",
  "author": "Kontur",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./index.ts",
    "./Heading": "./Heading.ts",
    "./Text": "./Text.ts",
    "./t.css": "./t.css",
    "./t.module.css": "./t.module.css",
    "./t.less": "./t.less",
    "./t.scss": "./t.scss"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "prerelease": "yarn build",
    "release": "npm publish ./dist --workspaces=false",
    "release:unstable": "yarn release --tag=unstable",
    "clean": "rimraf dist",
    "lint": "npm-run-all --continue-on-error --parallel lint:*",
    "lint:tsc": "tsc --noEmit --diagnostics",
    "lint:oxlint": "oxlint .",
    "lint:oxfmt": "node ../../scripts/run-oxfmt.mjs --check .",
    "prebuild": "yarn clean",
    "build": "run-s build:* build:lint:*",
    "build:static": "node --import=tsx ./scripts/generate.ts && node ../../scripts/run-oxfmt.mjs --write .",
    "build:tsc": "yarn tsc --outDir dist",
    "build:copyfiles": "copyfiles t.css t.module.css t.less t.scss package.json README.md CHANGELOG.md dist",
    "build:exports": "node ../../scripts/generate-exports.mts ./dist/package.json",
    "build:lint:publint": "publint --pack npm ./dist",
    "build:lint:attw": "attw --config-path ../../.attw.json ./dist --exclude-entrypoints t.css t.module.css t.less t.scss",
    "test": "vitest run",
    "storybook": "storybook dev -p 6064",
    "storybook:build": "storybook build -o .storybook/build --quiet",
    "storybook:docs-build": "storybook build --docs -c .storybook-docs -o .storybook/build --quiet",
    "storybook:docs": "storybook dev --docs -p 6065 -c .storybook-docs"
  },
  "dependencies": {
    "tslib": "2.6.2"
  },
  "devDependencies": {
    "@babel/core": "^7.24.6",
    "@babel/plugin-proposal-decorators": "7.24.6",
    "@babel/plugin-transform-runtime": "^7.24.6",
    "@babel/preset-env": "^7.24.6",
    "@babel/preset-react": "^7.24.6",
    "@babel/preset-typescript": "^7.24.6",
    "@emotion/css": "^11.11.2",
    "@skbkontur/icons": "2.0.10",
    "@skbkontur/react-ui": "^6.3.0",
    "@skbkontur/storybook-addon-live-examples": "1.0.0-beta.1",
    "@storybook/addon-docs": "8.6.14",
    "@storybook/addon-essentials": "8.6.14",
    "@storybook/blocks": "8.6.14",
    "@storybook/react": "8.6.14",
    "@storybook/react-webpack5": "8.6.14",
    "@types/less": "^3.0.8",
    "babel-loader": "^9.1.3",
    "core-js": "^3.37.1",
    "less": "^4.6.4",
    "sass": "^1.100.0",
    "storybook": "8.6.14",
    "string-replace-loader": "3.1.0"
  },
  "peerDependencies": {
    "react": ">=16.9 <20",
    "react-dom": ">=16.9 <20"
  }
}
