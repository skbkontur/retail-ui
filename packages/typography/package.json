{
  "name": "@skbkontur/typography",
  "version": "1.0.1",
  "description": "Kontur UI Typography",
  "author": "Kontur",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./index.ts",
    "./Heading": "./Heading.ts",
    "./Text": "./Text.ts",
    "./t.css": "./t.css",
    "./t.module.css": "./t.module.css",
    "./t.less": "./t.less",
    "./t.scss": "./t.scss"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "clean": "rimraf dist",
    "prebuild": "yarn clean",
    "build": "run-s build:* build:lint:*",
    "build:static": "node --import=tsx ./scripts/generate.ts && node ../../scripts/run-oxfmt.mjs --write .",
    "build:tsc": "yarn tsc --outDir dist",
    "build:copyfiles": "copyfiles t.css t.module.css t.less t.scss package.json README.md CHANGELOG.md dist",
    "build:exports": "node ../../scripts/generate-exports.mts ./dist/package.json",
    "build:lint:publint": "publint --pack npm ./dist",
    "build:lint:attw": "attw --config-path ../../.attw.json ./dist --exclude-entrypoints t.css t.module.css t.less t.scss"
  },
  "devDependencies": {
    "@types/less": "^3.0.8",
    "less": "^4.6.4",
    "sass": "^1.100.0"
  },
  "peerDependencies": {
    "react": ">=16.9 <20",
    "react-dom": ">=16.9 <20"
  }
}
